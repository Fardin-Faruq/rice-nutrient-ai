  "test_ratio": 0.15,
  "confidence_threshold": 0.65,
  "paths": {
    "raw": "data/raw",
    "processed": "data/processed",
    "splits": "data/splits",
    "models": "models",
    "outputs": "outputs",
    "four_class_output_root": "outputs_4class_v1"
  }
}
